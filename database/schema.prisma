generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Manager {
  id          Int          @id @default(autoincrement())
  cognitoId   String       @unique
  email       String
  firstName        String
  lastName         String
  phoneNumber String

  properties   Property[]
  buildings    Building[]
  tradespeople TradePerson[]
  conversations Conversation[]
}

model Tenant {
  id          Int      @id @default(autoincrement())
  cognitoId   String   @unique
  email       String
  firstName   String
  lastName    String
  phoneNumber String

  propertyId  Int    
  property    Property? @relation(fields: [propertyId], references: [id])
  tickets     Tickets[]
  conversations Conversation[]
  paymenttemplate     PaymentPlan? 
}


model TradePerson {
  id               Int      @id @default(autoincrement())
  cognitoId        String   @unique
  phone            String
  firstName        String
  lastName         String
  email            String
  address          String
  companyName      String
  service          String
  managerCognitoId String

  manager Manager @relation(fields: [managerCognitoId], references: [cognitoId])
  conversations Conversation[]
}

model Building {
  id                Int       @id @default(autoincrement())
  name              String
  photosUrl         String
  typeOfBuilding    String
  numberOfProperty  Int
  managerCognitoId  String
  locationId Int @unique

  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  manager    Manager @relation(fields: [managerCognitoId], references: [cognitoId])
  properties Property[]
}

model Location {
  id         Int      @id @default(autoincrement())
  address    String
  city       String
  state      String
  country    String
  postalCode String

  building   Building?
}


model Property {
  id                Int       @id @default(autoincrement())
  apartmentNumber   String?
  numberOfRooms     Int
  numberOfBathrooms Int
  size              Float
  buildingId        Int
  managerCognitoId  String

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  manager  Manager  @relation(fields: [managerCognitoId], references: [cognitoId])
  tickets  Tickets[]
  lease    Lease?  
  tenants  Tenant[] 
}


model Tickets {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String  
  submittedAt DateTime
  propertyId  Int
  tenantCognitoId String 
  tenant Tenant @relation(fields: [tenantCognitoId], references: [cognitoId], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Lease {
  id           Int       @id @default(autoincrement())
  startDate    DateTime
  endDate      DateTime
  deposit      Float
  typeOfLease  String
  monthlyPrice Int
  rentDueDateEachMonth Int 
  propertyId   Int       @unique

  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  paymenttemplate PaymentPlan[]
}

model PaymentPlan {
  id          Int       @id @default(autoincrement())
  setPrice    Int
  paymentDate DateTime

  leaseId     Int
  tenantId    Int  @unique  
  lease       Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments    Payment[] 
}

model Payment {
  id          Int       @id @default(autoincrement())
  amountPaid  Int
  paymentDate DateTime

  templateId  Int

  template    PaymentPlan? @relation(fields: [templateId], references: [id], onDelete: Cascade)
}


model Conversation {
  id                Int           @id @default(autoincrement())
  name              String
  managerCognitoId String
  tenantCognitoId   String?
  tradePersonCognitoId String?
  

  manager   Manager?    @relation(fields: [managerCognitoId], references: [cognitoId], onDelete: Cascade)
  tenant     Tenant?       @relation(fields: [tenantCognitoId], references: [cognitoId], onDelete: Cascade)
  tradePerson TradePerson? @relation(fields: [tradePersonCognitoId], references: [cognitoId], onDelete: Cascade)
  messages   Messages[]
}

model Messages {
  id              Int      @id @default(autoincrement())
  senderType      String   
  senderCognitoId String
  content         String
  createdAt       DateTime
  conversationId  Int

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

